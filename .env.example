# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# SUPABASE_KEY is an alias for SUPABASE_SERVICE_KEY used internally
SUPABASE_KEY=your_supabase_service_role_key_here

# ── Backend ───────────────────────────────────────────────────
BACKEND_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LEXORA_API_URL=http://localhost:8000

# ── n8n (Workflow Engine) ────────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678

# ── LLM / AI Providers ───────────────────────────────────────
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
GOOGLE_GEMINI_API_KEY=your_gemini_key_here

# ── Cohere (Text Embeddings & Reranking) ─────────────────────
# Required for L3 Tier 2 similarity search
COHERE_API_KEY=your_cohere_api_key_here
COHERE_EMBED_MODEL=embed-english-v3.0
COHERE_RERANK_MODEL=rerank-english-v3.0

# ── Qdrant (Vector Store) ────────────────────────────────────
# Required for L3 Tier 2 (set FRAUD_LAYER3_ENABLE_QDRANT=false to skip)
QDRANT_URL=https://your-cluster-id.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_TEXT=claims_v1_text
QDRANT_COLLECTION_MEDIA=claims_v1_media
QDRANT_TIMEOUT_SECONDS=5

# ── Neo4j Aura (Graph DB) ────────────────────────────────────
# Required for L3 Tier 3 graph analysis (set FRAUD_LAYER3_ENABLE_NEO4J=false to skip)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=your_neo4j_username
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=
NEO4J_TIMEOUT_SECONDS=5

# ── Jina AI (Multimodal Doc Embeddings) ──────────────────────
# Required for L3 image/PDF embeddings (set FRAUD_LAYER3_ENABLE_JINA_MEDIA=false to skip)
JINA_API_KEY=your_jina_api_key_here
JINA_EMBED_MODEL=jina-clip-v2

# ── L3 Feature Flags ─────────────────────────────────────────
# Set all to false for local-only mode (no external cloud calls)
FRAUD_LAYER3_ENABLE_QDRANT=false
FRAUD_LAYER3_ENABLE_NEO4J=false
FRAUD_LAYER3_ENABLE_JINA_MEDIA=false
FRAUD_LAYER3_ENABLE_RERANK=false

# ── L3 Free-Tier Guardrails ───────────────────────────────────
FRAUD_LAYER3_EXTERNAL_MAX_SECONDS=15
FRAUD_LAYER3_JINA_MAX_FILES_PER_CLAIM=1
FRAUD_LAYER3_MEDIA_MAX_MB=8
FRAUD_LAYER3_QDRANT_TOP_K=5
