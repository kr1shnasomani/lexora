# ============================================================
# Lexora Frontend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# URL of the running backend API (no trailing slash)
# In development this is the FastAPI server; in Docker it's still http://localhost:8000
# because the Vite dev server proxies /api to this address automatically.
VITE_API_URL=http://localhost:8000
